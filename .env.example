# Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration
DB_USER=postgres
DB_PASSWORD=changeme123
DB_NAME=my_lover
DB_PORT=5432

# Database Connection URL (used by Prisma)
# For local development:
# DATABASE_URL="postgresql://postgres:changeme123@localhost:5432/my_lover"
# For Docker deployment (using service name):
DATABASE_URL="postgresql://postgres:changeme123@postgres:5432/my_lover"

# Application Configuration
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security (Generate secure values for production)
# You can generate secure passwords using: openssl rand -base64 32
# DB_PASSWORD=<generate-secure-password>
